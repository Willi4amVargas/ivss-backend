# ─────────────────────────────────────────────────────────────────────────────
# Variables de entorno de ejemplo. Copia este archivo a `.env` y ajusta los
# valores antes de ejecutar la aplicación:
#
#     cp .env.example .env
#
# Los valores de este archivo son EJEMPLOS; reemplázalos por los reales.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ─── Base de datos (PostgreSQL) ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=ivss_v2

# ─── Servidor HTTP ───────────────────────────────────────────────────────────
PORT=3000
CORS_ORIGIN="*"

# ─── API local de clasificación ICD-11 (contenedor whoicd/icd-api) ───────────
ICD_API_LOCAL_URL="http://localhost:5045/"
ICD_RELEASE_ID="2026-01"
ICD_LINEARIZATION="mms"
ICD_API_VERSION="v2"
ICD_API_LANGUAGE="es"

# ─── Redis (caché de consultas de TypeORM) ───────────────────────────────────
# Si REDIS_URL está vacío, la URL se construye a partir de REDIS_HOST/PORT/...
REDIS_URL=
REDIS_TLS=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=changeme
REDIS_DB=0

# ─── Autenticación JWT ───────────────────────────────────────────────────────
# Genera un secreto seguro, por ejemplo: openssl rand -hex 32
JWT_SECRET=your_super_secure_random_secret_key_here

# ─── Correo (envío de notificaciones) ────────────────────────────────────────
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=user@example.com
MAIL_PASSWORD="your_app_password"
MAIL_ENCRYPTION=ssl
MAIL_FROM="no-reply@example.com"
