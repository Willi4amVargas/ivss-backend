{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "assets": [
      {
        "include": "../fonts/**/*",
        "outDir": "dist/fonts"
      },
      {
        "include": "../assets/**/*",
        "outDir": "dist/assets"
      }
    ]
  }
}
